---
import Base from '../layouts/Base.astro';
import { getPosts, url, formatDate } from '../lib/posts';

const posts = await getPosts();
---

<Base title="Soham's blog">
  <h1>Soham's blog</h1>
  <img class="portrait" src={url('portrait.svg')} alt="Hand-drawn portrait of Soham Kukreti" />
  <p>Things I build, break, and figure out along the way. Mostly Python, music, and the web.</p>
  <p>More about me on <a href="https://sohamkukreti.github.io/">my site</a>.</p>

  <h2>Posts</h2>
  {posts.length === 0 && <p>Nothing here yet.</p>}
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <span class="meta">{formatDate(post.date)}</span>
        <a href={url(`${post.id}/`)}>{post.title}</a>
        {post.data.draft && <span class="draft-tag">draft</span>}
        {post.data.description && <p>{post.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
